{
  "name": "treams-light-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run build && node check.mjs && node advanced-check.mjs",
    "build": "node build.mjs --bindings && tsc && node build.mjs",
    "format:check": "prettier --check *.ts *.mjs *.html *.css *.json",
    "test:ui": "node ui-check.mjs && node advanced-ui-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
