{
  "schema_version": 1,
  "description": "Optional predeclared complex128 native treams-rs CPU/CUDA comparison on an RTX 4080 SUPER. Twenty sequential cases. No upstream treams baseline is implied. Execute only after the main Mac/Linux CPU suites stop.",
  "build_commands": [
    [
      "just",
      "--command",
      "cargo",
      "build",
      "--locked",
      "--release",
      "-p",
      "treams-cuda",
      "--features",
      "cuda",
      "--examples"
    ],
    [
      "just",
      "--command",
      "cargo",
      "build",
      "--locked",
      "--release",
      "-p",
      "treams-cuda-tile",
      "--features",
      "cuda-tile",
      "--examples"
    ]
  ],
  "environment": "Source the existing CUDA 13.3 environment before building/running: toolkit bin on PATH, toolkit lib on LD_LIBRARY_PATH, matching libclang and CUDA/cuRAND headers. The wrapper never builds or replaces the Python extension. The suite still requires its existing release Python environment.",
  "protocol": {
    "precision": "complex128",
    "threads": [
      4,
      16
    ],
    "repetitions": 7,
    "cpu_affinity": "Each wrapper takes the first requested CPUs from its inherited allowed CPU set; supply 16 distinct physical cores to the controller. Recheck topology before reusing CPU IDs.",
    "correctness": "Existing examples run numerical reference and, for sampling, Hermitian-adjoint checks before reporting results. Any nonzero exit fails the case.",
    "timing": "Cached sampling preserves seven raw samples per phase. Fused examples emit medians of seven samples only; do not fabricate per-sample uncertainty. Keep context, JIT/first-call, upload, resident, download and full round-trip fields distinct.",
    "baseline": "CPU alternatives are shown explicitly. The fastest measured t4/t16 alternative is the best among these two budgets, not an exhaustive hardware optimum.",
    "memory": "Use logical resident operator/output buffer counts only. The cached example process VmHWM includes CPU layouts and staging and is not GPU VRAM. Do not report measured peak VRAM.",
    "diagnostic": "Two field-phases cases use a separate example kernel mirroring production FMA; production API timings come only from fields cases.",
    "gradient": "Cached sampling coefficient adjoints only. No geometry/wavevector GPU derivatives or framework routing claims.",
    "failure_policy": "Keep every case, including losses, errors, limits and regressions."
  },
  "cases": [
